---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE } from '../../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={`Services — ${SITE.name}`}
  description="Owner’s representation engagements: holdback and draw compliance, pre-construction audit, full representation, remote verification, project recovery, and prefab oversight."
>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <header class="max-w-3xl">
      <p class="annotation uppercase tracking-widest">Services</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Six engagements, one obligation</h1>
      <p class="prose mt-5">
        Every engagement below shares the same structure: we advise, review, verify, coordinate, and report —
        for the owner alone. You contract directly with your builder; we hold no contract with any
        contractor and take compensation from no one but you. Scope and fee shape are stated on each page;
        exact fees are fixed in writing before any engagement begins.
      </p>
    </header>

    <div class="mt-12">
      {
        services.map((service, i) => (
          <ServiceCard
            title={service.data.title}
            summary={service.data.summary}
            whoItsFor={service.data.whoItsFor}
            href={`/services/${service.data.slug}`}
            index={i}
          />
        ))
      }
    </div>

    <p class="prose mt-12 border-t border-rule pt-8">
      Unsure which fits? <a href="/project-review">Request a project review</a> — we will tell you honestly,
      including when the answer is that you do not need us yet.
    </p>
  </div>
</Base>
