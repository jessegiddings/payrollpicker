---
// STUB (spec §3.3): unlinked, noindex, excluded from sitemap.
// Activate only with real, permissioned client statements. No invented
// quotes, ever — one fake element ends a brand built on independence.
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base
  title={`Client References — ${SITE.name}`}
  description={`Client references for ${SITE.name}.`}
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <p class="annotation uppercase tracking-widest">References</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">We’d rather you call them</h1>
      <p class="prose mt-5">
        We publish no testimonials. Selected praise is the weakest form of evidence, and our clients' privacy
        outranks our marketing. What we offer instead: the direct contact details of every client we have
        had, provided to any serious enquiry. <a href="/contact">Ask us.</a>
      </p>
    </div>
  </div>
</Base>
